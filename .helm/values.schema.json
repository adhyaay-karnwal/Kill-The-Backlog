{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "baseDomain",
    "certManager",
    "main",
    "tls",
    "wwwBucketHostname",
    "zero"
  ],
  "properties": {
    "baseDomain": {
      "type": "string",
      "minLength": 1
    },
    "main": {
      "type": "object",
      "required": [
        "envVars",
        "resources"
      ],
      "properties": {
        "envVars": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "zero": {
      "type": "object",
      "required": [
        "envVars",
        "image",
        "resources",
        "storageSize"
      ],
      "properties": {
        "envVars": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storageSize": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "wwwBucketHostname": {
      "type": "string",
      "minLength": 1
    },
    "tls": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "certManager": {
      "type": "object",
      "required": [
        "enabled",
        "issuerRef"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "issuerRef": {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
